@inject LocaleService Locale
@implements IDisposable

<div class="nav-portfolio">
    <a class="logo-portfolio link-sem-animacao" href="#inicio">
        <span class="logo-icone"></span>
        <span class="logo-texto">Eros Karsburg</span>
    </a>

    <nav class="links-nav">
        <a class="link-nav" href="#inicio">@Locale.T("Nav.Home")</a>
        <a class="link-nav" href="#sobre">@Locale.T("Nav.About")</a>
        <a class="link-nav" href="#skills">@Locale.T("Nav.Skills")</a>
        <a class="link-nav" href="#projetos">@Locale.T("Nav.Projects")</a>
        <a class="link-nav" href="#contato">@Locale.T("Nav.Contact")</a>
    </nav>

    <LanguageSwitcher />
</div>

@code {
    protected override void OnInitialized()
    {
        Locale.OnChange += OnLocaleChanged;
    }

    private void OnLocaleChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Locale.OnChange -= OnLocaleChanged;
    }
}
