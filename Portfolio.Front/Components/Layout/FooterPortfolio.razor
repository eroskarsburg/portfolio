@inject LocaleService Locale
@implements IDisposable

<footer class="footer-portfolio">
    <nav class="footer-nav">
        <a class="footer-link" href="#inicio">@Locale.T("Nav.Home")</a>
        <a class="footer-link" href="#sobre">@Locale.T("Nav.About")</a>
        <a class="footer-link" href="#projetos">@Locale.T("Nav.Projects")</a>
        <a class="footer-link" href="#contato">@Locale.T("Nav.Contact")</a>
    </nav>
    <div class="footer-rodape">
        <a class="footer-logo link-sem-animacao" href="#inicio">
            <span class="logo-icone"></span>
        </a>
        <div class="footer-social">
            <a class="social-link" href="https://github.com/" target="_blank" rel="noopener noreferrer">@Locale.T("Footer.GitHub")</a>
            <a class="social-link" href="https://www.linkedin.com/" target="_blank" rel="noopener noreferrer">@Locale.T("Footer.LinkedIn")</a>
            <a class="social-link" href="mailto:contato@eroskarsburg.dev">@Locale.T("Footer.Email")</a>
        </div>
        <span class="footer-credito">@Locale.T("Footer.Credit", DateTime.Now.Year)</span>
    </div>
</footer>

@code {
    protected override void OnInitialized()
    {
        Locale.OnChange += OnLocaleChanged;
    }

    private void OnLocaleChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Locale.OnChange -= OnLocaleChanged;
    }
}
