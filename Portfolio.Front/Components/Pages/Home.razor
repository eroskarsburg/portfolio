@page "/"
@inject LocaleService Locale
@implements IDisposable

<PageTitle>@Locale.T("Page.Title")</PageTitle>

<div class="pagina-home" id="inicio">
    <section class="hero">
        <div class="hero-fundo" aria-hidden="true"></div>
        <div class="hero-grid">
            <div class="hero-conteudo">
                <p class="hero-status">@Locale.T("Hero.Status")</p>
                <p class="hero-saudacao">@Locale.T("Hero.Greeting")</p>
                <h1 class="hero-nome">@Locale.T("Hero.Name")</h1>
                <p class="hero-titulo">@Locale.T("Hero.Title")</p>
                <p class="hero-descricao">@Locale.T("Hero.Description")</p>
                <div class="hero-ctas">
                    <a class="btn-primario link-sem-animacao" href="#projetos">@Locale.T("Hero.CtaPrimary")</a>
                    <a class="btn-secundario link-sem-animacao" href="#contato">@Locale.T("Hero.CtaSecondary")</a>
                </div>
            </div>
            <div class="hero-visual">
                <img src="images/me.png" alt="Eros Karsburg" class="hero-foto" />
            </div>
        </div>
    </section>

    <div class="marquee" aria-hidden="true">
        <div class="marquee-track">
            @foreach (var skill in SkillsMarquee)
            {
                <span class="marquee-item">@skill</span>
            }
            @foreach (var skill in SkillsMarquee)
            {
                <span class="marquee-item">@skill</span>
            }
        </div>
    </div>

    <section class="sobre-secao" id="sobre">
        <div class="sobre-grid">
            <div>
                <p class="secao-eyebrow">@Locale.T("About.Eyebrow")</p>
                <h2 class="secao-titulo">@Locale.T("About.Title")</h2>
                <p class="sobre-texto">@Locale.T("About.Body")</p>
            </div>
            <div class="sobre-stats">
                <div class="stat">
                    <span class="stat-valor">@Locale.T("About.Stat1Value")</span>
                    <span class="stat-label">@Locale.T("About.Stat1Label")</span>
                </div>
                <div class="stat">
                    <span class="stat-valor">@Locale.T("About.Stat2Value")</span>
                    <span class="stat-label">@Locale.T("About.Stat2Label")</span>
                </div>
                <div class="stat">
                    <span class="stat-valor">@Locale.T("About.Stat3Value")</span>
                    <span class="stat-label">@Locale.T("About.Stat3Label")</span>
                </div>
            </div>
        </div>
    </section>

    <section class="skills-secao" id="skills">
        <div class="secao-cabecalho">
            <h2 class="secao-titulo">@Locale.T("Skills.Title")</h2>
            <p class="secao-subtitulo">@Locale.T("Skills.Subtitle")</p>
        </div>
        <div class="skills-grid">
            @foreach (var skill in Skills)
            {
                <span class="skill-chip">@skill</span>
            }
        </div>
    </section>

    <section class="projetos-secao" id="projetos">
        <div class="secao-cabecalho">
            <h2 class="secao-titulo">@Locale.T("Projects.Title")</h2>
            <p class="secao-subtitulo">@Locale.T("Projects.Subtitle")</p>
        </div>
        <div class="projetos-grid">
            <article class="projeto-card">
                <div class="projeto-media">
                    <img src="images/projects/orderflow.png" alt="@Locale.T("Project1.Name")" />
                    <span class="projeto-tag">@Locale.T("Project1.Tag")</span>
                </div>
                <div class="projeto-body">
                    <h3 class="projeto-nome">@Locale.T("Project1.Name")</h3>
                    <p class="projeto-descricao">@Locale.T("Project1.Description")</p>
                    <a class="projeto-link" href="#contato">@Locale.T("Projects.KnowMore")</a>
                </div>
            </article>
            <article class="projeto-card">
                <div class="projeto-media">
                    <img src="images/projects/dashboard.png" alt="@Locale.T("Project2.Name")" />
                    <span class="projeto-tag">@Locale.T("Project2.Tag")</span>
                </div>
                <div class="projeto-body">
                    <h3 class="projeto-nome">@Locale.T("Project2.Name")</h3>
                    <p class="projeto-descricao">@Locale.T("Project2.Description")</p>
                    <a class="projeto-link" href="#contato">@Locale.T("Projects.KnowMore")</a>
                </div>
            </article>
            <article class="projeto-card">
                <div class="projeto-media">
                    <img src="images/projects/paybridge.png" alt="@Locale.T("Project3.Name")" />
                    <span class="projeto-tag">@Locale.T("Project3.Tag")</span>
                </div>
                <div class="projeto-body">
                    <h3 class="projeto-nome">@Locale.T("Project3.Name")</h3>
                    <p class="projeto-descricao">@Locale.T("Project3.Description")</p>
                    <a class="projeto-link" href="#contato">@Locale.T("Projects.KnowMore")</a>
                </div>
            </article>
            <article class="projeto-card">
                <div class="projeto-media">
                    <img src="images/projects/catalog.png" alt="@Locale.T("Project4.Name")" />
                    <span class="projeto-tag">@Locale.T("Project4.Tag")</span>
                </div>
                <div class="projeto-body">
                    <h3 class="projeto-nome">@Locale.T("Project4.Name")</h3>
                    <p class="projeto-descricao">@Locale.T("Project4.Description")</p>
                    <a class="projeto-link" href="#contato">@Locale.T("Projects.KnowMore")</a>
                </div>
            </article>
        </div>
    </section>

    <section class="contato-secao" id="contato">
        <div class="contato-painel">
            <h2 class="contato-titulo">@Locale.T("Contact.Title")</h2>
            <p class="contato-descricao">@Locale.T("Contact.Description")</p>
            <a class="btn-primario link-sem-animacao" href="mailto:contato@eroskarsburg.dev">@Locale.T("Contact.Cta")</a>
        </div>
    </section>
</div>

@code {
    private static readonly string[] Skills =
    [
        "C#", ".NET", "ASP.NET Core", "Blazor", "SQL Server",
        "Entity Framework", "Azure", "Git", "Clean Architecture"
    ];

    private static readonly string[] SkillsMarquee =
    [
        "C#", ".NET", "ASP.NET Core", "Blazor", "SQL Server",
        "Entity Framework", "Azure", "Git", "Clean Architecture", "REST APIs"
    ];

    protected override void OnInitialized()
    {
        Locale.OnChange += OnLocaleChanged;
    }

    private void OnLocaleChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Locale.OnChange -= OnLocaleChanged;
    }
}
